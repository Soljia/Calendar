# --- Collector ---
PORT=8080
# Must match the Roblox secret "analytics_key" (Creator Hub > Secrets)
INGEST_KEY=change-me-long-random-string
DATA_DIR=./data
RETENTION_DAYS=14
GAME_NAME=My Game

# Health thresholds
FPS_DEGRADED=50
FPS_CRITICAL=30
MEMORY_DEGRADED_MB=4000
MEMORY_CRITICAL_MB=5500
PING_DEGRADED_MS=250
ERROR_SPIKE_PER_SAMPLE=20

# --- Discord (optional; leave DISCORD_TOKEN empty to run without the bot) ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
PUBLIC_STATUS_CHANNEL_ID=
ADMIN_STATUS_CHANNEL_ID=
ALERT_CHANNEL_ID=
CAPTURE_CHANNEL_ID=
ADMIN_ROLE_ID=
STATUS_UPDATE_SECONDS=60

# --- Roblox Open Cloud (lets Discord admins start captures) ---
# API key needs the messaging-service:publish permission for this universe.
ROBLOX_OPEN_CLOUD_KEY=
ROBLOX_UNIVERSE_ID=
ROBLOX_MESSAGING_TOPIC=AnalyticsCommand
