# Copy to .env and fill in. Never commit the real .env.

# The Gmail account that receives the Venmo emails
GMAIL_ADDRESS=you@gmail.com

# 16-character App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# The 4 recipients, comma-separated
FORWARD_TO=person1@example.com,person2@example.com,person3@example.com,person4@example.com

# Optional settings (defaults shown)
# REQUIRED_TERMS=paid you,venmo
# Only forward mail from these senders/domains (empty = anyone), e.g. venmo.com
# ALLOWED_SENDERS=
# PROCESSED_LABEL=Venmo-Forwarded
# IMAP_FOLDER=INBOX
# LOOKBACK_DAYS=2
# LOG_LEVEL=INFO
