# ---------------------------------------------------------------------------
# Zoom Breakout Chat Monitor -- example configuration
#
# Copy to .env and fill in. NEVER commit .env; it is in .gitignore.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# === Zoom ==================================================================

# REQUIRED. "Secret Token" from your Zoom app's Feature / Event Subscription
# page. Every webhook delivery is rejected unless it is signed with this.
ZOOM_WEBHOOK_SECRET_TOKEN=

# OPTIONAL: Server-to-Server OAuth credentials.
#
# The chat monitor does NOT need these. They are used only to offer
# pre-assigned breakout-room names as rename suggestions
# (GET /meetings/{meetingId} -> settings.breakout_room.rooms[].name).
# Leave blank to skip that feature entirely.
#
# Scope required when you do set them: meeting:read:meeting:admin
# (legacy scope name: meeting:read:admin)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# Reject deliveries whose x-zm-request-timestamp is older than this many
# seconds (replay protection). 0 disables the check.
ZOOM_WEBHOOK_MAX_AGE_SECONDS=300

# === Authentication ========================================================

# The local admin account. The password is bcrypt-hashed into the database on
# first start; changing it here rotates the hash and signs out every session.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# REQUIRED in production. Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank a random key is generated per process, so every restart signs
# everyone out.
SESSION_SECRET=

SESSION_TTL_HOURS=12

# Set to true once the dashboard is served over HTTPS, so the session cookie
# is only ever sent on an encrypted connection.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# === Database ==============================================================

# SQLite by default. The compose file overrides the path to the mounted
# volume. Any SQLAlchemy URL works, for example:
#   postgresql+psycopg://user:password@postgres:5432/zoomchat
# (add "psycopg[binary]" to backend/requirements.txt when you do)
DATABASE_URL=sqlite:///data/zoomchat.db

# === Privacy ===============================================================

# When false (the default), direct/private messages are recorded as metadata
# only -- the message text is never written to disk, never broadcast and never
# shown. Turning this on stores and displays private participant messages.
# Read the Privacy section of the README before changing it.
DISPLAY_PRIVATE_MESSAGES=false

# Delete stored messages older than this many days. 0 keeps them forever.
CHAT_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_MINUTES=60

# Keep the original Zoom delivery next to the normalised row for debugging.
# Never served through the API. Private messages are exempt either way.
STORE_RAW_WEBHOOK_PAYLOAD=true

# === Behaviour =============================================================

# Default "quiet room" threshold in minutes. Editable later in the UI.
INACTIVITY_WARNING_MINUTES=5

LOG_LEVEL=INFO
MAX_REQUEST_BYTES=1048576

# === Development ===========================================================

# Exposes /api/dev/simulation and the Settings page simulation panel.
# MUST be false in production: with it off those routes do not exist at all.
DEV_MODE=false

# === Networking ============================================================

# Where the dashboard is published on the Docker host.
# Bind to 127.0.0.1 if you terminate TLS with a separate reverse proxy.
HTTP_PORT=8080
HTTP_BIND=0.0.0.0

# Only needed if you serve the UI from a different origin than the API.
# The shipped compose setup is single-origin, so leave this empty.
CORS_ALLOW_ORIGINS=

# Requests per minute, per client IP.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
